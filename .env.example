SIGNAL_ALERTS_ENABLED=true
SIGNAL_ALERTS_INTERVAL_MINUTES=15
SCHEDULED_BRIEFS_ENABLED=true
DAILY_OVERVIEW_ENABLED=false
DAILY_OVERVIEW_TIME=20:30
DAILY_OVERVIEW_GRACE_MINUTES=180
PAPER_PERIOD_UPDATES_ENABLED=true
PAPER_PERIOD_UPDATE_TIME=22:30
PAPER_PERIOD_UPDATE_GRACE_MINUTES=360
PAPER_WEEKLY_UPDATE_WEEKDAY=fri
BRIEF_WARMUP_ENABLED=true
BRIEF_WARMUP_INTERVAL_SECONDS=300

TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=<telegram-chat-id>
# Required for SEC primary-source verification unless SEC_USER_AGENT is set.
SEC_CONTACT_EMAIL=<contact-email-for-sec-user-agent>
# Browser Push stays disabled in the private beta; Telegram is the only push channel.
BROWSER_PUSH_ENABLED=false
BRIEF_SCHEDULE_TIMEZONE=Europe/Berlin
BRIEF_SCHEDULE_WEEKDAYS=mon,tue,wed,thu,fri
BRIEF_DELIVERY_GRACE_MINUTES=360
BRIEF_MAX_JOBS_PER_RUN=1
MORNING_BRIEF_TIME=07:15
EUROPE_OPEN_BRIEF_TIME=08:40
MIDDAY_BRIEF_TIME=12:30
US_OPEN_BRIEF_TIME=15:10
CLOSE_RECAP_TIME=21:45
APP_ACCESS_PASSWORD=<strong-private-access-code>
APP_SESSION_SECRET=<long-random-session-secret>
APP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
APP_LOGIN_MAX_ATTEMPTS=5
APP_LOGIN_LOCKOUT_MINUTES=15
APP_ENV=production
APP_COOKIE_SECURE=true
APP_DATA_DIR=/app/data
# Optional override. Defaults to APP_DATA_DIR/portfolios.db.
PORTFOLIO_DB_PATH=

# Optional official Scalable Capital CLI integration. The application invokes a
# closed read-only command allowlist and never stores Broker passwords or 2FA data.
SCALABLE_INTEGRATION_ENABLED=false
SCALABLE_AUTO_SYNC_ENABLED=true
SCALABLE_AUTO_SYNC_INTERVAL_MINUTES=15
SCALABLE_AUTO_SYNC_START_DELAY_SECONDS=60
SCALABLE_TELEGRAM_DECISIONS_ENABLED=true
SCALABLE_DECISION_TIMEOUT_SECONDS=120
SCALABLE_CLI_PATH=/app/data/scalable-cli/bin/sc
SCALABLE_CLI_TIMEOUT_SECONDS=25
SCALABLE_CLI_MAX_OUTPUT_BYTES=2097152
SCALABLE_CONTEXT_REFRESH_TIMEOUT_SECONDS=120
SCALABLE_MARKET_CONTEXT_MAX_POSITIONS=50
SCALABLE_QUOTE_CACHE_SECONDS=240
SCALABLE_NEWS_CACHE_MINUTES=30
SCALABLE_NEWS_MAX_PER_SYNC=3
SCALABLE_NEWS_LOCALE=de_DE
SCALABLE_TRANSACTIONS_CACHE_MINUTES=15
SCALABLE_FEEDBACK_MAX_SIGNAL_AGE_DAYS=7
SCALABLE_FEEDBACK_MIN_SAMPLES=20
# Pin the verified official binary in production (lowercase SHA-256, 64 chars).
SCALABLE_CLI_SHA256=
# Keep CLI config/session on an access-restricted persistent volume.
XDG_CONFIG_HOME=/app/data/scalable-cli/xdg/config
XDG_DATA_HOME=/app/data/scalable-cli/xdg/data
XDG_STATE_HOME=/app/data/scalable-cli/xdg/state
XDG_CACHE_HOME=/app/data/scalable-cli/xdg/cache
# Optional exact ISIN -> market ticker overrides, for example:
# SCALABLE_ISIN_TICKER_MAP={"US0378331005":"AAPL"}
SCALABLE_ISIN_TICKER_MAP={}
SCALABLE_RECONCILIATION_TOLERANCE_EUR=0.05
PAPER_TRADE_MANAGEMENT_SOFT_COOLDOWN_HOURS=8
PAPER_TRADE_MANAGEMENT_REPEAT_HOURS=24
PAPER_TRADE_MANAGEMENT_PNL_DELTA_PCT=3
MACRO_ALERT_COOLDOWN_HOURS=12
MACRO_ALERT_SCORE_ESCALATION_DELTA=15
CRITICAL_MARKET_ALERT_MAX_ITEMS=3
# Managed backups default to APP_DATA_DIR/backups on the same persistent volume.
APP_DAILY_BACKUP_ENABLED=true
APP_BACKUP_DIR=/app/data/backups
APP_BACKUP_INTERVAL_HOURS=24
APP_BACKUP_RETENTION_COUNT=14
APP_RESTORE_TEST_INTERVAL_DAYS=7
OPERATIONAL_ALERTS_ENABLED=true
OPERATIONAL_ALERT_COOLDOWN_HOURS=6
OPERATIONAL_MARKET_FEED_CONFIRMATION_CHECKS=3
OPERATIONAL_QUOTE_STALE_SECONDS=900

# Authenticated Alpaca market/news streaming. Disabled until paper credentials
# and the actual feed entitlement have been verified. IEX is one exchange;
# use SIP only with the corresponding subscription.
ALPACA_MARKET_DATA_ENABLED=false
ALPACA_NEWS_STREAM_ENABLED=true
ALPACA_API_KEY_ID=<alpaca-paper-key-id>
ALPACA_API_SECRET_KEY=<alpaca-paper-secret-key>
ALPACA_MARKET_FEED=iex
ALPACA_STREAM_SYMBOLS=AAPL,MSFT,NVDA,SPY,QQQ
ALPACA_SNAPSHOT_MAX_AGE_SECONDS=20

# Real Alpaca paper broker. The implementation rejects every live/custom host.
ALPACA_PAPER_ENABLED=false
ALPACA_PAPER_API_KEY_ID=<alpaca-paper-trading-key-id>
ALPACA_PAPER_API_SECRET_KEY=<alpaca-paper-trading-secret-key>
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER_STREAM_URL=wss://paper-api.alpaca.markets/stream
ALPACA_PAPER_TIMEOUT_SECONDS=10
BROKER_RECONCILIATION_REQUIRED=true
BROKER_RECONCILIATION_START_DELAY_SECONDS=5
BROKER_RECONCILIATION_INTERVAL_SECONDS=30
BROKER_RECONCILIATION_MAX_AGE_SECONDS=90
BROKER_RECONCILIATION_QUANTITY_TOLERANCE=0.000001
BROKER_RECONCILIATION_EQUITY_TOLERANCE=1.00
BROKER_PAPER_MAX_SHORT_POSITION_PCT=12.0
BROKER_PAPER_MAX_TOTAL_SHORT_PCT=30.0

# Fast-paper remains disabled until the authenticated stream passes its soak.
FAST_PAPER_ENABLED=false
FAST_EQUITY_MAX_QUOTE_AGE_MS=2000
FAST_CRYPTO_MAX_QUOTE_AGE_MS=1000
FAST_EQUITY_MAX_SPREAD_BPS=50
FAST_ETF_MAX_SPREAD_BPS=30
FAST_CRYPTO_MAX_SPREAD_BPS=100
FAST_REQUIRE_REGULAR_SESSION=true
FAST_MAX_CLOCK_SKEW_MS=1000
MARKET_STREAM_DISCONNECT_KILL_SECONDS=5
MARKET_SAFETY_INTERVAL_SECONDS=2
LATENCY_MONITOR_WINDOW_MINUTES=60
LATENCY_SAMPLE_EVERY_N_EVENTS=10
LATENCY_RETENTION_HOURS=168
LATENCY_BUDGET_PROVIDER_TO_RECEIVE_MS=2000
LATENCY_BUDGET_NORMALIZE_MS=100
LATENCY_BUDGET_SIGNAL_MS=500
LATENCY_BUDGET_RISK_MS=250
LATENCY_BUDGET_SUBMIT_ACK_MS=2000
LATENCY_BUDGET_FILL_MS=5000
LATENCY_BUDGET_TELEGRAM_MS=5000

# Paper-learning risk and market-data gates. No real-money execution.
PAPER_CAPITAL_PROFILE=conviction
PAPER_TRADING_STARTING_CAPITAL=500000
PAPER_TRADING_CURRENCY=EUR
PAPER_TRADING_RISK_PER_TRADE_PCT=0.75
PAPER_TRADING_MAX_OPEN_RISK_PCT=6.0
PAPER_TRADING_MAX_POSITION_PCT=20.0
PAPER_TRADING_MAX_GROSS_EXPOSURE_PCT=90.0
PAPER_TRADING_MIN_CASH_RESERVE_PCT=10.0
PAPER_TRADING_TARGET_GROSS_EXPOSURE_PCT=75.0
PAPER_TRADING_MAX_TICKER_EXPOSURE_PCT=25.0
PAPER_TRADING_SHORT_RISK_MULTIPLIER=0.75
PAPER_TRADING_MAX_SHORT_POSITION_PCT=12.0
PAPER_TRADING_MAX_TOTAL_SHORT_EXPOSURE_PCT=30.0
PAPER_TRADING_SYNTHETIC_CRYPTO_SHORTS_ENABLED=true
PAPER_TRADING_CRYPTO_SHORT_RISK_MULTIPLIER=0.50
PAPER_TRADING_MAX_CRYPTO_SHORT_POSITION_PCT=5.0
PAPER_TRADING_MAX_TOTAL_CRYPTO_SHORT_EXPOSURE_PCT=10.0
PAPER_TRADING_CRYPTO_SHORT_FUNDING_BPS_PER_DAY=5.0
PAPER_TRADING_HIGH_CONVICTION_MIN_SCORE=90
PAPER_TRADING_MEDIUM_CONVICTION_MIN_SCORE=80
PAPER_TRADING_HIGH_CONVICTION_RISK_MULTIPLIER=1.0
PAPER_TRADING_MEDIUM_CONVICTION_RISK_MULTIPLIER=0.80
PAPER_TRADING_MAX_OPTION_PREMIUM_PCT=0.75
PAPER_TRADING_MAX_OPEN_OPTION_PREMIUM_PCT=2.0
PAPER_TRADING_RISK_PER_OPTION_TRADE_PCT=0.25
PAPER_TRADING_MAX_OPEN_TRADES=16
PAPER_TRADING_MAX_OPEN_PER_STRATEGY=4
PAPER_TRADING_DAILY_LOSS_LIMIT_PCT=1.5
PAPER_TRADING_MAX_DRAWDOWN_PCT=12.0
PAPER_TRADING_MAX_CONSECUTIVE_LOSSES=3
PAPER_TRADING_LOSS_STREAK_COOLDOWN_HOURS=24
PAPER_TRADING_AUTO_MIN_SCORE=88
PAPER_TRADING_EXPLORATION_MIN_SCORE=60
PAPER_TRADING_NEWS_CONTEXT_MAX_AGE_SECONDS=3600
PAPER_MARKET_DATA_MAX_AGE_HOURS=96
PAPER_MIN_AVG_DOLLAR_VOLUME=2000000
PAPER_EXECUTION_EQUITY_BPS=8
PAPER_EXECUTION_ETF_BPS=6
PAPER_EXECUTION_CRYPTO_BPS=18
PAPER_EXECUTION_OPTION_BPS=125
PAPER_FEE_EQUITY_BPS=1
PAPER_FEE_ETF_BPS=1
PAPER_FEE_CRYPTO_BPS=8
PAPER_FEE_OPTION_BPS=5
PAPER_FEE_OPTION_PER_CONTRACT=0.65
PAPER_EXECUTION_CALIBRATION_DAYS=90
PAPER_EXECUTION_CALIBRATION_MIN_SAMPLES=5
# Telegram-Evidenzübersicht nur bei echten Meilensteinen statt bei jedem Outcome.
PAPER_EVIDENCE_STATUS_CLOSED_STEP=5
PAPER_EVIDENCE_STATUS_OUTCOME_STEP=10

# Optional read-only options market data. Production provides realtime US
# options data for eligible Tradier Brokerage accounts; sandbox is delayed.
# Broker Freund never sends orders and never treats a quote as a fill guarantee.
TRADIER_ACCESS_TOKEN=<tradier-production-market-data-token>
TRADIER_ENVIRONMENT=production
TRADIER_TIMEOUT_SECONDS=8
